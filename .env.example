# Copy to .env and adjust. Every value has a working default for a single
# local checkout; override ports when running parallel checkouts.

# Compose project name; namespace it per checkout to avoid container clashes.
# COMPOSE_PROJECT_NAME=agent-trail

# Control plane
API_ADDR=:8080
# Keep the port here in sync with POSTGRES_PORT if you override it.
DATABASE_URL=postgres://agent_trail:agent_trail@localhost:5432/agent_trail?sslmode=disable
LOG_LEVEL=info

# GitHub App integration: set all three together, or none (the webhook then
# answers 503). Values come from the registered app; the key file stays under
# the gitignored secrets/ directory. See docs/architecture/github-app.md.
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.private-key.pem
# API root override for tests and GitHub Enterprise; default api.github.com.
# GITHUB_API_BASE_URL=

# Worker / runner, all in whole seconds (docs/architecture/runner.md).
# RUNNER_LEASE_SECONDS=60
# RUNNER_HEARTBEAT_SECONDS=10
# RUNNER_LOST_AFTER_SECONDS=30
# WORKER_POLL_SECONDS=2

# Base directory for the git mirror cache and task worktrees; absolute path
# (docs/architecture/git-workspaces.md).
# WORKSPACE_ROOT=/var/lib/agent-trail

# Agent adapter (docs/architecture/agent-providers.md). AGENT_PROVIDER is
# "fake" (default, no model cost) or "claude-code". The rest apply only to
# claude-code. The API key is passed through ANTHROPIC_API_KEY from the
# environment; it is never written here.
# AGENT_PROVIDER=fake
# AGENT_CLI_PATH=claude
# AGENT_MODEL=
# AGENT_PERMISSION_MODE=acceptEdits
# Require this string in `claude --version`, or the worker refuses to start.
# AGENT_CLI_VERSION=
# Hard per-attempt runtime cap, whole seconds.
# AGENT_TIMEOUT_SECONDS=2700
# ANTHROPIC_API_KEY=

# Infra ports (host side, localhost only)
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3300
