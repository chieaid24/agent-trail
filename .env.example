# COMPOSE_PROJECT_NAME=agent-trail

API_ADDR=:8080
# keep in sync with POSTGRES_PORT override
DATABASE_URL=postgres://agent_trail:agent_trail@localhost:5432/agent_trail?sslmode=disable
LOG_LEVEL=info

# host:port plaintext otlp/grpc; "off" disables export; sync with OTLP_GRPC_PORT override
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# set all three or none; unset -> webhook answers 503
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.private-key.pem
# GITHUB_API_BASE_URL=

# set both or neither; when set every /api/v1 route needs a session
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# AUTH_PUBLIC_ORIGIN=
# AUTH_COOKIE_SECURE=false
# GITHUB_OAUTH_BASE_URL=

# RUNNER_LEASE_SECONDS=60
# RUNNER_HEARTBEAT_SECONDS=10
# RUNNER_LOST_AFTER_SECONDS=30
# WORKER_POLL_SECONDS=2

# kubernetes mode needs RUNNER_IMAGE; controller injects TASK_ATTEMPT_ID, never set it
# RUNNER_TYPE=process
# RUNNER_IMAGE=agent-trail/runner:0.1.0
# RUNNER_JOB_TEMPLATE=/etc/agent-trail/runner-job.yaml
# RUNNER_TTL_SECONDS=300
# WORKER_MAX_TASKS=0
# WORKER_IDLE_EXIT_SECONDS=0

# WORKSPACE_ROOT=/var/lib/agent-trail

# AGENT_TIMEOUT_SECONDS=2700

# fake or claude-code; creds come from worker env / runner-agent secret, never this file
# AGENT_PROVIDER=fake
# AGENT_CLI_PATH=claude
# AGENT_MODEL=
# AGENT_PERMISSION_MODE=acceptEdits
# exact token required in `claude --version`, else worker refuses to start
# AGENT_CLI_VERSION=

# CONFLICT_LLM_ENABLED=false
# CONFLICT_LLM_PROVIDER=fake
# CONFLICT_LLM_MODEL=claude-sonnet-4-6

# POSTGRES_PORT=5432
# GRAFANA_PORT=3300
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318
