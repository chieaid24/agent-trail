# Copy to .env and adjust. Every value has a working default for a single
# local checkout; override ports when running parallel checkouts.

# Compose project name; namespace it per checkout to avoid container clashes.
# COMPOSE_PROJECT_NAME=agent-trail

# Control plane
API_ADDR=:8080
# Keep the port here in sync with POSTGRES_PORT if you override it.
DATABASE_URL=postgres://agent_trail:agent_trail@localhost:5432/agent_trail?sslmode=disable
LOG_LEVEL=info

# GitHub App integration: set all three together, or none (the webhook then
# answers 503). Values come from the registered app; the key file stays under
# the gitignored secrets/ directory. See docs/architecture/github-app.md.
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.private-key.pem
# API root override for tests and GitHub Enterprise; default api.github.com.
# GITHUB_API_BASE_URL=

# Infra ports (host side, localhost only)
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3300
