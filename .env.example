# Copy to .env and adjust. Every value has a working default for a single
# local checkout; override ports when running parallel checkouts.

# Compose project name; namespace it per checkout to avoid container clashes.
# COMPOSE_PROJECT_NAME=agent-trail

# Control plane
API_ADDR=:8080
# Keep the port here in sync with POSTGRES_PORT if you override it.
DATABASE_URL=postgres://agent_trail:agent_trail@localhost:5432/agent_trail?sslmode=disable
LOG_LEVEL=info

# OTLP/gRPC collector for metric and trace export (host:port, plaintext).
# Defaults to the compose collector; keep in sync with OTLP_GRPC_PORT if you
# override it. Set "off" to disable export (the /metrics endpoint stays).
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# GitHub App integration: set all three together, or none (the webhook then
# answers 503). Values come from the registered app; the key file stays under
# the gitignored secrets/ directory.
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.private-key.pem
# API root override for tests and GitHub Enterprise; default api.github.com.
# GITHUB_API_BASE_URL=

# Dashboard sessions: the app's OAuth client credentials, both together or
# neither (auth endpoints then answer 503 and the localhost API stays open).
# With them set, every /api/v1 route requires a signed-in session. Register
# <AUTH_PUBLIC_ORIGIN>/backend/auth/github/callback as a callback URL on the
# app.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# App slug for the dashboard's install link; optional.
# GITHUB_APP_SLUG=
# Browser-facing dashboard origin; default http://localhost:3000.
# AUTH_PUBLIC_ORIGIN=
# Mark auth cookies Secure; set true behind HTTPS.
# AUTH_COOKIE_SECURE=false
# github.com root override for tests and GitHub Enterprise; default
# https://github.com.
# GITHUB_OAUTH_BASE_URL=

# Worker and runner durations, all in whole seconds.
# RUNNER_LEASE_SECONDS=60
# RUNNER_HEARTBEAT_SECONDS=10
# RUNNER_LOST_AFTER_SECONDS=30
# WORKER_POLL_SECONDS=2

# Select in-process execution (default) or the Kubernetes Job controller.
# RUNNER_TYPE=process
# Kubernetes controller settings. RUNNER_IMAGE is required in controller mode.
# The controller injects TASK_ATTEMPT_ID into each Job; do not set it manually.
# RUNNER_IMAGE=agent-trail/runner:0.1.0
# RUNNER_JOB_TEMPLATE=/etc/agent-trail/runner-job.yaml
# RUNNER_TTL_SECONDS=300
# Process runners can cap attempts or exit after an idle interval.
# WORKER_MAX_TASKS=0
# WORKER_IDLE_EXIT_SECONDS=0

# Base directory for the git mirror cache and task worktrees; absolute path.
# WORKSPACE_ROOT=/var/lib/agent-trail

# Default attempt runtime when max_runtime_seconds is omitted, whole seconds.
# AGENT_TIMEOUT_SECONDS=2700

# AGENT_PROVIDER is "fake" (default, no model cost) or "claude-code".
# The CLI settings apply only to claude-code. Process mode reads credentials
# from the worker environment. Kubernetes Jobs read them from the optional
# runner-agent Secret. Never write credentials to this file.
# AGENT_PROVIDER=fake
# AGENT_CLI_PATH=claude
# AGENT_MODEL=
# One of: default, acceptEdits, plan, bypassPermissions.
# AGENT_PERMISSION_MODE=acceptEdits
# Require this exact version token in `claude --version`, or the worker
# refuses to start.
# AGENT_CLI_VERSION=

# Optional semantic conflict analysis. The off switch wins over provider
# settings. Anthropic mode quietly stays disabled when no API key is present.
# CONFLICT_LLM_ENABLED=false
# CONFLICT_LLM_PROVIDER=fake
# CONFLICT_LLM_MODEL=claude-sonnet-4-6
# Infra ports (host side, localhost only)
# POSTGRES_PORT=5432
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318
